# ═══════════════════════════════════════════════════════════════════════════════════════
# LLM Evaluation Framework — Environment Configuration (Mode B: Standalone)
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Set GROQ_API_KEY with your actual key (REQUIRED for evaluation)
# 3. Adjust other values as needed for your environment
# 4. NEVER commit .env — it contains secrets and is gitignored
#
# USAGE:
# - This file is for Mode B (standalone development)
# - For Docker Mode A (workspace root), use root .env instead
# - All services run on localhost with standard ports
#
# ═══════════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 1: API SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8002

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 2: LLM PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# Provider selection: "groq" (cloud, fast) | "ollama" (local, RAM-heavy)
LLM_PROVIDER=groq

# Groq configuration (cloud provider)
GROQ_MODEL=mixtral-8x7b-32768
GROQ_API_KEY=gsk_your_actual_key_here

# Ollama configuration (local provider - optional)
# OLLAMA_MODEL=phi3:mini
# OLLAMA_KEEP_ALIVE=0

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 3: EMBEDDING MODEL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# Embedding model for consistency evaluation
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 4: INFERENCE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
INFERENCE_TIMEOUT_SECONDS=900
INFERENCE_MAX_RETRIES=3
INFERENCE_RETRY_BACKOFF_BASE=2

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 5: PIPELINE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
CHECKPOINT_DIR=logs/checkpoints
RESULTS_DIR=reports/results
DATASET_BASE_DIR=data/dataset
# ═══════════════════════════════════════════════════════════════════════════════════════
